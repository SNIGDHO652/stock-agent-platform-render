ENVIRONMENT=local
LOG_LEVEL=INFO
API_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stock_agent
AUTO_CREATE_SCHEMA=true
RATE_LIMIT_PER_MINUTE=30
MARKET_DATA_PERIOD=5y
BENCHMARK_TICKER=SPY
ANALYSIS_CACHE_TTL_SECONDS=900
JOB_LEASE_SECONDS=1800
ENABLE_CREWAI_DEFAULT=true
OPENAI_API_KEY=
CREWAI_MODEL=openai/gpt-4.1-mini
CORS_ORIGINS=["http://localhost:3000"]
